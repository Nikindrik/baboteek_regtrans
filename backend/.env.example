APP_NAME=mosgortrans-delay-predictor
APP_ENV=production
LOG_LEVEL=info
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=5s
NDTP_TCP_PORT=9201
NDTP_READ_TIMEOUT=30s
ML_GRPC_HOST=127.0.0.1
ML_GRPC_PORT=50051
ML_GRPC_TIMEOUT=1s
ML_ENABLE_FALLBACK=true
SCHEDULE_CSV_PATH=data/schedule_plan.csv
UNIT_MAPPING_CSV_PATH=data/unit_tr_mapping.csv
TIMEZONE=Europe/Moscow
# Demo-only clock alignment for the Jan-2026 schedule. Never use as production logic.
TIME_SHIFT_HOURS=-12
